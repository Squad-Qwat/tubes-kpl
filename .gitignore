## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## This .gitignore file is based on the GitHub .gitignore template:
## https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2024+/2022/2019/2017 cache/options directory
.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# Visual Studio Code
.vscode/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Windows image build caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on separate drives
$RECYCLE.BIN/

# Visual Studio Code project settings
.vscode/
# .vscode settings should be committed depending on your preference.
# Sometimes it's useful to commit .vscode/extensions.json or .vscode/launch.json,
# but usually not .vscode/settings.json or .vscode/tasks.json.
#!.vscode/extensions.json

# Tooling
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# MightyMoose
*.mm.*
AutoTest.Net/

# Web workbench (sass)
.sass-cache/

# Installshield-resizer
Express/

# DocProject is a documentation generator for .NET
DocProject/buildhelp/
DocProject/Help/*.mcw

# CODESYS
*.compileinfo

# Lutz Roeder's .NET Reflector
*.Selector.xml

# NDepend
NDependOut/

# Microsoft Azure Build Output
csx/
*.build.csdef

# Azure Code Analysis Output
ecf/

# Performance Tools
*.ruleset
*.psess
*.vsp
*.vspx
*.sap

# GitHub Extension for Visual Studio
*.ghuc

# Visual Studio enamored files
*.DotSettings
*.suo
*.user
*.userosscache
*.sln.docstates

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Core
appsettings.json
Config/

# StyleCop
StyleCop.Cache
StyleCop.Settings.StyleCop

# StyleCop.Analyzers
StyleCop.Analyzers.Cache

# JetBrains Rider
.idea/
*.sln.iml

# Mac
.DS_Store
